# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.in text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.pdf binary
*.docx binary
*.png binary

# Preserve original bytes of checksum-bearing experiment evidence.
docs/assets/phase1/*20261011.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
