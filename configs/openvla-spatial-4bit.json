    "proprio": false,
    "resolution_sim": 256,
    "resolution_policy": 224,
    "center_crop_area": 0.9,
    "native_prompt": "In: What action should the robot take to {task_label.lower()}?\nOut:"
  },
  "action_steps_per_query": 1,
  "role": "candidate_under_validation",
  "advance_rule": "Load and real-observation smoke check, then original task8 baseline; paired N before A; no X/U or automatic main-model promotion."
